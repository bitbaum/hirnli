# Database — PostgreSQL (Neon)
# Get from https://neon.tech/  (free tier available)
DATABASE_URL=postgres://user:pass@host.neon.tech/dbname?sslmode=require

# Auth — Internal HTTP Basic gate for /fundraising/* and /api/*
# Optional in local dev (if unset, all routes are open)
INTERNAL_PASSWORD=

# HMAC secret for signed /gesuch/share/[token] URLs
# Generate: openssl rand -hex 32
SHARE_SECRET=

# Email — Resend (used by Gesuch send + ack flows)
RESEND_API_KEY=

# Cron security — used by /api/cron/* endpoints (Vercel Cron)
CRON_SECRET=

# Pipeline — LLM for foundation triage / graduation
# Free tier: https://console.groq.com/
GROQ_API_KEY=

# Pipeline — Web search for foundation discovery (optional)
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CX=

# Build — set to skip the predev/prebuild sync step
# (useful when DB is unreachable; `npm run dev` will use existing
# stiftungen-generated.ts without refreshing it)
# SKIP_SYNC=1
