{
  "crons": [
    {
      "path": "/api/cron/deadline-reminder",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/data-quality",
      "schedule": "0 8 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/pages/finanzen", "destination": "/finanzen", "permanent": true },
    { "source": "/pages/kennzahlen", "destination": "/wirkung", "permanent": true },
    { "source": "/kennzahlen", "destination": "/wirkung", "permanent": true },
    { "source": "/pages/wirkung", "destination": "/wirkung", "permanent": true },
    { "source": "/pages/methodik", "destination": "/methodik", "permanent": true },
    { "source": "/pages/transparenz", "destination": "/methodik", "permanent": true },
    { "source": "/transparenz", "destination": "/methodik", "permanent": true },
    { "source": "/pages/preismodell", "destination": "/preismodell", "permanent": true },
    { "source": "/pages/strategie", "destination": "/strategie", "permanent": true },
    { "source": "/pages/team", "destination": "/team", "permanent": true },
    { "source": "/pages/operations", "destination": "/operations", "permanent": true },
    { "source": "/pages/dokumente", "destination": "/dokumente", "permanent": true },
    { "source": "/pages/fundraising", "destination": "/fundraising", "permanent": true },
    { "source": "/pages/fundraising/stiftungen", "destination": "/fundraising/stiftungen", "permanent": true },
    { "source": "/pages/fundraising/stiftungen/:slug", "destination": "/fundraising/stiftungen/:slug", "permanent": true }
  ]
}
