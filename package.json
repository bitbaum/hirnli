    "lint:umlauts": "! grep -rn 'ß' src/ --include='*.ts' --include='*.tsx' | grep -v 'ss statt ß' | grep -v node_modules | grep -v 'stiftungen-generated.ts' && echo 'No ß found' || (echo 'ERROR: Found ß (should be ss in Swiss German) in source code (foundation data in stiftungen-generated.ts is excluded — that file mirrors DB content sourced from German foundations)' && exit 1)",
