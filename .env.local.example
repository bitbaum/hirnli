# Database — PostgreSQL (self-hosted on the Hetzner box, shared with revampit)
# From a dev machine, tunnel first (see docs/DEPLOYMENT.md):
#   ssh -N -L 15432:127.0.0.1:5432 root@167.233.22.31
DATABASE_URL=postgresql://user:pass@127.0.0.1:15432/revampit

# Auth — Internal HTTP Basic gate for /fundraising/* and /api/*
# Optional in local dev (unset = open). REQUIRED in production:
# the middleware fails closed (503) if unset with NODE_ENV=production.
INTERNAL_PASSWORD=

# HMAC secret for signed /gesuch/share/[token] URLs
# Generate: openssl rand -hex 32
SHARE_SECRET=

# Email — Resend (used by Gesuch send + ack flows)
RESEND_API_KEY=

# Cron security — used by /api/cron/* endpoints (called by the scheduler)
CRON_SECRET=

# Pipeline — LLM for foundation triage / graduation
# Free tier: https://console.groq.com/
GROQ_API_KEY=

# Pipeline — Web search for foundation discovery (optional)
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CX=
